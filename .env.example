# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). Both are safe to expose to the browser
# (that's what NEXT_PUBLIC_ means) — access is controlled by the Row Level
# Security policies in supabase/schema.sql, not by keeping these secret.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
